# Copy to .env and fill in. EVERYTHING works without these keys — the AI strategist
# falls back to a real-time behavioural analysis and explanations are templated. Set a
# key only to have answers phrased live by an LLM.

# Option A — OpenRouter (recommended: one key, many models). Powers the strategist,
# the per-customer recommendation, the chatbot phrasing, and decision explanations.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Option B — Anthropic (Claude) directly, used if OpenRouter isn't set.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional — Postgres for persistence across restarts (defaults to local SQLite).
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
